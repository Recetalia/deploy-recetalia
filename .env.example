# Recetalia — deploy environment variables (pre-prod)
#
# Copiar a `.env` en el servidor remoto y en local (este archivo NO se commitea).
#   cp .env.example .env
#   edit .env
#
# NOTA: las DBs no están containerizadas (salvo en el override de dev del .98).
# NINGUNA API trae ya la base en su `application.yml`: los defaults son localhost
# y la config real sale de las vars de acá. Las que llevan `:?` en el compose son
# obligatorias — si faltan, el `compose up` aborta en vez de arrancar un servicio
# apuntando a una base inexistente.

# =============================================================================
# Docker
# =============================================================================
# Tag para todas las imágenes. Usar `latest` para iteración rápida,
# un SHA/semver (ej. `pre-20260421`) para trazabilidad.
IMAGE_TAG=latest

# =============================================================================
# Self-hosted registry (Distribution v2)
# =============================================================================
# Subdominio donde vive el registry — expuesto por nginx con TLS de LE.
# Las imágenes se taggean como $REGISTRY_HOST/recetalia/<proyecto>:$IMAGE_TAG
REGISTRY_HOST=registrypre.recetadigital.uy

# Credenciales basic-auth — se generan con htpasswd, ver registry/README.md.
# En local, el dev hace `docker login $REGISTRY_HOST` con estas credenciales
# antes de `docker compose push`. En el server, el daemon docker las usa
# para `docker compose pull` (credenciales en ~/.docker/config.json).
REGISTRY_USER=recetalia
REGISTRY_PASSWORD=change-me

# =============================================================================
# TLS — Let's Encrypt (jonasal/nginx-certbot)
# =============================================================================
# Email para la cuenta de LE (recibe avisos de expiración).
CERTBOT_EMAIL=ops@recetadigital.uy

# 1 = usar staging de LE durante bootstrap (cert no confiable pero sin rate
# limits; conviene para validar DNS). Pasar a 0 para obtener certs reales.
LETSENCRYPT_STAGING=0

# 1 = jonasal emite certs self-signed con una CA local, sin pedir a LE. Necesario
# para validar un server por IP ANTES del cutover DNS (el HTTP-01 de LE fallaría
# porque el dominio todavía resuelve a otro server, y jonasal deshabilitaría los
# server blocks 443). Poner 0 / quitar al hacer el cutover de DNS a certs reales.
USE_LOCAL_CA=0

# =============================================================================
# Frontends
# =============================================================================
# medical-provider-app usa `local` o `prod` como nombre de build configuration
# (no es el estándar de Angular). Para pre-prod poner `prod`.
MEDICAL_PROVIDER_ENVIRONMENT=prod

# =============================================================================
# Databases — override de `recetalia-api-rest` hacia DO managed de pre-prod
# =============================================================================
# IMPORTANTE: los defaults del application.yml de `recetalia-api-rest` apuntan
# a PROD (143.110.212.167). En pre-prod hay que overridear estas 6 vars para
# que el service apunte a la DO managed (mismo host que security-api y
# transversal-api, cuyos yml ya apuntan ahí).
#
# `security-api-recetalia` y `transversal-recetalia-api` tampoco traen ya la base en
# su application.yml, así que SECURITY_DB_* y TRANSVERSAL_* son OBLIGATORIAS.

RECETALIA_DB_URL=jdbc:mysql://recetaliadbpreproduccion-do-user-2735981-0.i.db.ondigitalocean.com:25060/recetali_receta
RECETALIA_DB_USER=doadmin
RECETALIA_DB_PASSWORD=REDACTED_SET_IN_DEPLOY

# security-api-recetalia — schema `securitydb`. Obligatorias (el compose usa `:?`).
SECURITY_DB_URL=jdbc:mysql://recetaliadbpreproduccion-do-user-2735981-0.i.db.ondigitalocean.com:25060/securitydb
SECURITY_DB_USER=doadmin
SECURITY_DB_PASSWORD=REDACTED_SET_IN_DEPLOY

# transversal-recetalia-api — R2DBC (no JDBC), dos bases. Obligatorias (`:?`).
TRANSVERSAL_DB_URL=r2dbc:mysql://recetaliadbpreproduccion-do-user-2735981-0.i.db.ondigitalocean.com:25060/recetali_receta
TRANSVERSAL_DB_USER=doadmin
TRANSVERSAL_DB_PASSWORD=REDACTED_SET_IN_DEPLOY
TRANSVERSAL_DNMA_DB_URL=r2dbc:mysql://recetaliadbpreproduccion-do-user-2735981-0.i.db.ondigitalocean.com:25060/recetali_dnma
TRANSVERSAL_DNMA_DB_USER=doadmin
TRANSVERSAL_DNMA_DB_PASSWORD=REDACTED_SET_IN_DEPLOY

RECETALIA_DNMA_DB_URL=jdbc:mysql://recetaliadbpreproduccion-do-user-2735981-0.i.db.ondigitalocean.com:25060/recetali_dnma
RECETALIA_DNMA_DB_USER=doadmin
RECETALIA_DNMA_DB_PASSWORD=REDACTED_SET_IN_DEPLOY

# Credenciales read-only de la DB para el listado de farmacias del site institucional
SITE_DB_HOST=recetaliadbpreproduccion-...ondigitalocean.com
SITE_DB_PORT=25060
SITE_DB_USER=site_ro
SITE_DB_PASS=CHANGE_ME
SITE_DB_NAME=recetali_receta

# DigitalOcean Monitoring (dashboard de Control en Gestión) — token READ-ONLY.
# Sin token el dashboard degrada limpio ("sin datos"). Droplet = host prod (.217).
DO_API_TOKEN=
DO_DROPLET_ID=581853033
DO_DB_CLUSTER_UUID=983784dc-fc0a-4679-8924-f927c6b3a937

# ── Guard de destinatarios de mail (api-rest) ───────────────────────────────
# Los envíos de mail se prueban ÚNICAMENTE contra casillas nuestras. No alcanza
# con recordarlo al probar: el disparador es un flujo de la app (un operador
# carga el correo de un QF en Gestión) y el mail sale solo hacia un profesional
# real. Por eso el filtro va en el envío.
#   PRE / DEV  → enabled=true  + las casillas propias
#   PROD       → enabled=false (passthrough, comportamiento de siempre)
# Una entrada que empieza con "@" habilita el dominio entero.
# ⚠️ enabled=true con la lista VACÍA no manda nada. Es a propósito.
EMAIL_ALLOWLIST_ENABLED=false
EMAIL_ALLOWLIST_RECIPIENTS=@recetalia.com

# Link de invitación del Químico Farmacéutico. Por ambiente: su default en el
# application.yml es el dominio de PROD, así que un PRE sin esta variable le
# manda al químico un link a qf.recetalia.com.
#   PRE  → https://qfpre.recetalia.com/definir-clave
#   PROD → https://qf.recetalia.com/definir-clave
QF_REGISTRATION_URL=https://qf.recetalia.com/definir-clave
